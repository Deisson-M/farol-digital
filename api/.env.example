# Ambiente: development | test | production
NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# Conexão MySQL 8 (use o docker-compose.yml da raiz para subir um banco local)
DATABASE_URL=mysql://farol:farol_dev_senha@localhost:3306/farol_digital
# true para bancos na nuvem que exigem SSL (ex.: Aiven)
DATABASE_SSL=false

# Gere um segredo forte: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-por-um-valor-aleatorio-com-32-ou-mais-caracteres
JWT_EXPIRES_IN=2h

# Origens autorizadas para o frontend (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Senha inicial usada SOMENTE pelo seed de desenvolvimento
SEED_SENHA_PADRAO=Farol@2026dev

# Endereço do frontend (usado no link de redefinição de senha)
APP_URL=http://localhost:5173

# Pagamentos: nesta etapa só existe o provedor "simulado" (nenhuma cobrança real).
PAGAMENTOS_PROVEDOR=simulado
# Segredo para assinar/validar webhooks de pagamento (32+ caracteres aleatórios)
PAGAMENTOS_WEBHOOK_SEGREDO=troque-este-segredo-de-webhook-por-um-valor-aleatorio
